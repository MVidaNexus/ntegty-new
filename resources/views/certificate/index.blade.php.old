                                :class="template === 'elegant' ? 'border-purple-500 bg-purple-50 shadow-lg scale-105' : 'border-gray-200 hover:border-purple-300'">
                            <div class="text-3xl mb-2 group-hover:scale-110 transition-transform">👑</div>
                            <div class="text-sm font-bold" :class="template === 'elegant' ? 'text-purple-700' : 'text-gray-700'">أنيق</div>
                            <div x-show="template === 'elegant'" class="absolute -top-2 -right-2 bg-purple-500 text-white text-xs px-2 py-1 rounded-full font-bold">✓</div>
                        </button>
                    </div>
                </div>

                <!-- Color Theme -->
                <div class="bg-white rounded-2xl shadow-xl p-5 md:p-6 border-2 border-orange-100">
                    <h3 class="text-lg md:text-xl font-black text-slate-800 mb-4 flex items-center gap-2 border-b-2 border-orange-100 pb-3">
                        <span class="text-2xl">🎨</span>
                        <span>لون التصميم</span>
                    </h3>
                    <div class="grid grid-cols-4 gap-3">
                        <button @click="theme = 'blue'; drawCertificate()" 
                                class="group relative h-14 rounded-xl bg-gradient-to-br from-blue-400 to-blue-700 ring-4 transition-all duration-300 hover:scale-110 shadow-lg" 
                                :class="theme === 'blue' ? 'ring-blue-400 scale-110' : 'ring-transparent'">
                            <div x-show="theme === 'blue'" class="absolute inset-0 flex items-center justify-center text-white text-xl font-bold">✓</div>
                        </button>
                        <button @click="theme = 'gold'; drawCertificate()" 
                                class="group relative h-14 rounded-xl bg-gradient-to-br from-amber-400 to-amber-700 ring-4 transition-all duration-300 hover:scale-110 shadow-lg" 
                                :class="theme === 'gold' ? 'ring-amber-400 scale-110' : 'ring-transparent'">
                            <div x-show="theme === 'gold'" class="absolute inset-0 flex items-center justify-center text-white text-xl font-bold">✓</div>
                        </button>
                        <button @click="theme = 'emerald'; drawCertificate()" 
                                class="group relative h-14 rounded-xl bg-gradient-to-br from-emerald-400 to-emerald-700 ring-4 transition-all duration-300 hover:scale-110 shadow-lg" 
                                :class="theme === 'emerald' ? 'ring-emerald-400 scale-110' : 'ring-transparent'">
                            <div x-show="theme === 'emerald'" class="absolute inset-0 flex items-center justify-center text-white text-xl font-bold">✓</div>
                        </button>
                        <button @click="theme = 'purple'; drawCertificate()" 
                                class="group relative h-14 rounded-xl bg-gradient-to-br from-purple-400 to-purple-700 ring-4 transition-all duration-300 hover:scale-110 shadow-lg" 
                                :class="theme === 'purple' ? 'ring-purple-400 scale-110' : 'ring-transparent'">
                            <div x-show="theme === 'purple'" class="absolute inset-0 flex items-center justify-center text-white text-xl font-bold">✓</div>
                        </button>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="space-y-3">
                    <button @click="downloadCertificate" 
                            class="w-full bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-600 hover:to-emerald-700 text-white font-black py-4 md:py-5 rounded-2xl shadow-2xl hover:shadow-3xl transform active:scale-95 transition-all duration-300 flex items-center justify-center gap-3 text-base md:text-lg group">
                        <svg class="w-6 h-6 md:w-7 md:h-7 group-hover:animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                        </svg>
                        <span>✅ تحميل الشهادة</span>
                    </button>

                    <button @click="shareOnSocial" 
                            class="w-full bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-600 hover:to-indigo-700 text-white font-black py-4 rounded-2xl shadow-xl hover:shadow-2xl transform active:scale-95 transition-all duration-300 flex items-center justify-center gap-3 text-base md:text-lg group">
                        <svg class="w-6 h-6 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M15 8a3 3 0 10-2.977-2.63l-4.94 2.47a3 3 0 100 4.319l4.94 2.47a3 3 0 10.895-1.789l-4.94-2.47a3.027 3.027 0 000-.74l4.94-2.47C13.456 7.68 14.19 8 15 8z"></path>
                        </svg>
                        <span>📤 مشاركة الشهادة</span>
                    </button>
                </div>
            </div>

            <!-- Preview Column -->
            <div class="w-full lg:w-3/5 xl:w-2/3">
                <div class="bg-gradient-to-br from-slate-100 to-slate-200 rounded-3xl p-4 md:p-6 shadow-2xl border-4 border-white sticky top-4">
                    <div class="bg-white rounded-2xl p-3 md:p-4 shadow-inner">
                        <div class="aspect-[1.414/1] w-full relative">
                            <canvas id="certificateCanvas" class="w-full h-full bg-white rounded-xl shadow-2xl"></canvas>
                        </div>
                    </div>
                    <div class="mt-4 text-center">
                        <p class="text-xs md:text-sm text-slate-600 font-bold flex items-center justify-center gap-2">
                            <span class="inline-block w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
                            <span>🔄 المعاينة المباشرة - يتم التحديث تلقائياً</span>
                        </p>
                    </div>
                </div>

                <!-- Tips Section -->
                <div class="mt-6 bg-gradient-to-r from-blue-50 to-indigo-50 rounded-2xl p-5 md:p-6 border-2 border-blue-200 shadow-lg">
                    <h4 class="font-black text-blue-900 mb-3 flex items-center gap-2 text-base md:text-lg">
                        <span class="text-2xl">💡</span>
                        <span>نصائح للحصول على أفضل نتيجة:</span>
                    </h4>
                    <ul class="space-y-2 text-xs md:text-sm text-blue-800">
                        <li class="flex items-start gap-2">
                            <span class="text-blue-500 mt-0.5 font-bold">✓</span>
                            <span>اكتب الاسم كاملاً كما هو في بطاقة الرقم القومي</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <span class="text-blue-500 mt-0.5 font-bold">✓</span>
                            <span>اختر التصميم والألوان المناسبة لنوع الشهادة</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <span class="text-blue-500 mt-0.5 font-bold">✓</span>
                            <span>الشهادة يتم تحميلها بدقة عالية جداً مناسبة للطباعة</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <span class="text-blue-500 mt-0.5 font-bold">✓</span>
                            <span>يمكنك مشاركة الشهادة على Facebook و WhatsApp</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@push('scripts')
<script>
document.addEventListener('alpine:init', () => {
    Alpine.data('certificateGenerator', () => ({
        studentName: '',
        schoolName: '',
        examType: 'prep',
        totalScore: '',
        maxScore: '',
        gender: 'male',
        theme: 'blue',
        template: 'modern',
        canvas: null,
        ctx: null,
        width: 2480,
        height: 1754,
        
        init() {
            this.canvas = document.getElementById('certificateCanvas');
            this.ctx = this.canvas.getContext('2d');
            
            this.canvas.width = this.width;
            this.canvas.height = this.height;
            
            document.fonts.ready.then(() => {
                this.drawCertificate();
            });
        },
        
        getColors() {
            const colors = {
                gold: { 
                    primary: '#b45309', 
                    secondary: '#f59e0b', 
                    accent: '#fbbf24', 
                    bg: '#fffbeb', 
                    light: '#fef3c7',
                    dark: '#78350f'
                },
                blue: { 
                    primary: '#1e40af', 
                    secondary: '#3b82f6', 
                    accent: '#60a5fa', 
                    bg: '#eff6ff', 
                    light: '#dbeafe',
                    dark: '#1e3a8a'
                },
                emerald: { 
                    primary: '#047857', 
                    secondary: '#10b981', 
                    accent: '#34d399', 
                    bg: '#ecfdf5', 
                    light: '#d1fae5',
                    dark: '#064e3b'
                },
                purple: { 
                    primary: '#6b21a8', 
                    secondary: '#a855f7', 
                    accent: '#c084fc', 
                    bg: '#faf5ff', 
                    light: '#f3e8ff',
                    dark: '#581c87'
                },
            };
            return colors[this.theme];
        },
        
        drawCertificate() {
            if (this.template === 'modern') {
                this.drawModernTemplate();
            } else {
                this.drawElegantTemplate();
            }
        },
        
        drawModernTemplate() {
            const ctx = this.ctx;
            const w = this.width;
            const h = this.height;
            const colors = this.getColors();
            
            ctx.clearRect(0, 0, w, h);
            
            // Background with gradient
            const bgGradient = ctx.createLinearGradient(0, 0, w, h);
            bgGradient.addColorStop(0, '#ffffff');
            bgGradient.addColorStop(0.5, colors.bg);
            bgGradient.addColorStop(1, colors.light);
            ctx.fillStyle = bgGradient;
            ctx.fillRect(0, 0, w, h);
            
            // Decorative corner shapes
            ctx.fillStyle = colors.accent + '30';
            ctx.beginPath();
            ctx.arc(w - 200, 200, 350, 0, Math.PI * 2);
            ctx.fill();
            
            ctx.fillStyle = colors.secondary + '20';
            ctx.beginPath();
            ctx.arc(200, h - 200, 300, 0, Math.PI * 2);
            ctx.fill();
            
            // Left accent bar
            const barGradient = ctx.createLinearGradient(0, 0, 0, h);
            barGradient.addColorStop(0, colors.primary);
            barGradient.addColorStop(0.5, colors.secondary);
            barGradient.addColorStop(1, colors.accent);
            ctx.fillStyle = barGradient;
            ctx.fillRect(0, 0, 50, h);
            
            // Top decorative line
            ctx.fillStyle = colors.primary;
            ctx.fillRect(0, 0, w, 30);
            
            // Logo area (top center)
            ctx.font = 'bold 70px "Tajawal", sans-serif';
            ctx.fillStyle = colors.primary;
            ctx.textAlign = 'center';
            ctx.fillText('Ntegty.com', w/2, 150);
            
            // Main title
            ctx.font = 'bold 140px "Tajawal", sans-serif';
            ctx.fillStyle = colors.primary;
            ctx.fillText('شهادة تقدير', w/2, 320);
            
            // Subtitle
            ctx.font = '55px "Tajawal", sans-serif';
            ctx.fillStyle = colors.dark;
            ctx.fillText('CERTIFICATE OF APPRECIATION', w/2, 400);
            
            // Divider
            ctx.fillStyle = colors.accent;
            ctx.fillRect(w/2 - 350, 450, 700, 8);
            
            // Content intro
            ctx.font = '60px "Tajawal", sans-serif';
            ctx.fillStyle = '#1e293b';
            const pronoun = this.gender === 'male' ? 'أن يتقدم' : 'أن تتقدم';
            const studentTitle = this.gender === 'male' ? 'للطالب' : 'للطالبة';
            ctx.fillText(`يسر مدير المدرسة ${pronoun} بخالص التهاني ${studentTitle}:`, w/2, 600);
            
            // Student name with background
            ctx.font = 'bold 130px "Tajawal", sans-serif';
            const name = this.studentName || 'اسم الطالب هنا';
            const nameWidth = ctx.measureText(name).width;
            
            // Name background
            ctx.fillStyle = colors.primary + '15';
            ctx.fillRect(w/2 - nameWidth/2 - 60, 670, nameWidth + 120, 160);
            
            // Name text
            ctx.fillStyle = colors.primary;
            ctx.fillText(name, w/2, 790);
            
            // Underline
            ctx.fillStyle = colors.accent;
            ctx.fillRect(w/2 - nameWidth/2 - 40, 820, nameWidth + 80, 4);
            
            // Achievement text
            ctx.font = '65px "Tajawal", sans-serif';
            ctx.fillStyle = '#334155';
            const examTypeText = this.examType === 'prep' ? 'الصف الأول الإعدادي أو الثالث الإعدادي' : 
                                 this.examType === 'secondary' ? 'الصف الثاني الثانوي أو الثالث الثانوي' : 
                                 'الصف السادس الابتدائي';
            
            const achievement = this.gender === 'male' ? 'عند نجاحه(ها) في نتيجة' : 'عند نجاحه(ها) في نتيجة';
            ctx.fillText(achievement + ' ' + examTypeText, w/2, 970);
            
            // Score display
            if (this.totalScore && this.maxScore) {
                ctx.font = 'bold 90px "Tajawal", sans-serif';
                ctx.fillStyle = colors.secondary;
                const scoreText = `وحصوله(ها) على مجموع ${this.totalScore} من ${this.maxScore}`;
                ctx.fillText(scoreText, w/2, 1120);
            }
            
            // School name
            if (this.schoolName) {
                ctx.font = 'bold 70px "Tajawal", sans-serif';
                ctx.fillStyle = colors.primary;
                const yPos = (this.totalScore && this.maxScore) ? 1250 : 1120;
                ctx.fillText(this.schoolName, w/2, yPos);
            }
            
            // Congratulations text
            ctx.font = 'bold 65px "Tajawal", sans-serif';
            ctx.fillStyle = colors.dark;
            const finalY = this.schoolName ? ((this.totalScore && this.maxScore) ? 1370 : 1240) : ((this.totalScore && this.maxScore) ? 1240 : 1110);
            const congrats = this.gender === 'male' ? 'كما نتمنى له مزيداً من التفوق والنجاح' : 'كما نتمنى لها مزيداً من التفوق والنجاح';
            ctx.fillText(congrats, w/2, finalY);
            
            // Footer section
            const date = new Date().toLocaleDateString('ar-EG', { year: 'numeric', month: 'long', day: 'numeric' });
            
            ctx.font = '50px "Tajawal", sans-serif';
            ctx.fillStyle = '#64748b';
            
            // Date (right)
            ctx.textAlign = 'right';
            ctx.fillText('التاريخ: ' + date, w - 150, h - 180);
            
            // Signature line (right)
            ctx.beginPath();
            ctx.moveTo(w - 450, h - 200);
            ctx.lineTo(w - 150, h - 200);
            ctx.strokeStyle = '#cbd5e1';
            ctx.lineWidth = 3;
            ctx.stroke();
            
            // Manager title (left)
            ctx.textAlign = 'left';
            ctx.fillText('مدير المدرسة', 150, h - 180);
            
            // Signature line (left)
            ctx.beginPath();
            ctx.moveTo(150, h - 200);
            ctx.lineTo(450, h - 200);
            ctx.stroke();
            
            // Bottom branding
            ctx.textAlign = 'center';
            ctx.font = 'bold 55px "Tajawal", sans-serif';
            ctx.fillStyle = colors.primary;
            ctx.fillText('تم إنشاء الشهادة بواسطة منصة نتيجتي - Ntegty.com', w/2, h - 90);
            
            // Bottom decorative line
            ctx.fillStyle = colors.primary;
            ctx.fillRect(0, h - 30, w, 30);
        },
        
        drawElegantTemplate() {
            const ctx = this.ctx;
            const w = this.width;
            const h = this.height;
            const colors = this.getColors();
            
            ctx.clearRect(0, 0, w, h);
            
            // Elegant cream background
            const bgGradient = ctx.createRadialGradient(w/2, h/2, 0, w/2, h/2, Math.max(w, h));
            bgGradient.addColorStop(0, '#ffffff');
            bgGradient.addColorStop(0.7, colors.bg);
            bgGradient.addColorStop(1, colors.light);
            ctx.fillStyle = bgGradient;
            ctx.fillRect(0, 0, w, h);
            
            // Ornate borders
            ctx.strokeStyle = colors.primary;
            ctx.lineWidth = 8;
            ctx.strokeRect(100, 100, w - 200, h - 200);
            
            ctx.strokeStyle = colors.secondary;
            ctx.lineWidth = 4;
            ctx.strokeRect(130, 130, w - 260, h - 260);
            
            ctx.strokeStyle = colors.accent;
            ctx.lineWidth = 2;
            ctx.strokeRect(150, 150, w - 300, h - 300);
            
            // Corner decorations
            this.drawElegantCorner(ctx, 100, 100, 180, colors.primary);
            this.drawElegantCorner(ctx, w - 100, 100, 180, colors.primary);
            this.drawElegantCorner(ctx, w - 100, h - 100, 180, colors.primary);
            this.drawElegantCorner(ctx, 100, h - 100, 180, colors.primary);
            
            // Crown icon
            ctx.font = '200px serif';
            ctx.textAlign = 'center';
            ctx.fillText('👑', w/2, 380);
            
            // Main title
            ctx.font = 'bold 140px "Tajawal", sans-serif';
            ctx.fillStyle = colors.primary;
            ctx.fillText('شهادة تقدير', w/2, 560);
            
            // Elegant divider
            this.drawElegantDivider(ctx, w/2, 630, 500, colors.secondary);
            
            // Content
            ctx.font = '58px "Tajawal", sans-serif';
            ctx.fillStyle = '#374151';
            const pronoun = this.gender === 'male' ? 'تُمنح' : 'تُمنح';
            const studentTitle = this.gender === 'male' ? 'للطالب المتفوق' : 'للطالبة المتفوقة';
            ctx.fillText(`${pronoun} هذه الشهادة بكل فخر واعتزاز ${studentTitle}:`, w/2, 760);
            
            // Name
            ctx.font = 'bold 140px "Tajawal", sans-serif';
            ctx.fillStyle = colors.primary;
            const name = this.studentName || 'اسم الطالب';
            ctx.fillText(name, w/2, 940);
            
            // Decorative line under name
            const nameWidth = ctx.measureText(name).width;
            ctx.strokeStyle = colors.accent;
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.moveTo(w/2 - nameWidth/2 - 50, 980);
            ctx.lineTo(w/2 + nameWidth/2 + 50, 980);
            ctx.stroke();
            
            // Achievement details
            ctx.font = '62px "Tajawal", sans-serif';
            ctx.fillStyle = '#4b5563';
            const examTypeText = this.examType === 'prep' ? 'الصف الأول الإعدادي أو الثالث الإعدادي' : 
                                 this.examType === 'secondary' ? 'الصف الثاني الثانوي أو الثالث الثانوي' : 
                                 'الصف السادس الابتدائي';
            
            const achievement = this.gender === 'male' ? 'تقديراً لنجاحه المتميز في' : 'تقديراً لنجاحها المتميز في';
            ctx.fillText(achievement + ' ' + examTypeText, w/2, 1110);
            
            // Score
            if (this.totalScore && this.maxScore) {
                ctx.font = 'bold 80px "Tajawal", sans-serif';
                ctx.fillStyle = colors.secondary;
                ctx.fillText(`بمجموع ${this.totalScore} من ${this.maxScore}`, w/2, 1230);
            }
            
            // School
            if (this.schoolName) {
                ctx.font = 'bold 65px "Tajawal", sans-serif';
                ctx.fillStyle = colors.primary;
                const yPos = (this.totalScore && this.maxScore) ? 1340 : 1230;
                ctx.fillText(this.schoolName, w/2, yPos);
            }
            
            // Footer
            const date = new Date().toLocaleDateString('ar-EG', { year: 'numeric', month: 'long', day: 'numeric' });
            ctx.font = '48px "Tajawal", sans-serif';
            ctx.fillStyle = '#6b7280';
            
            // Date
            ctx.textAlign = 'right';
            ctx.fillText('التاريخ: ' + date, w - 250, h - 200);
            ctx.beginPath();
            ctx.moveTo(w - 500, h - 220);
            ctx.lineTo(w - 200, h - 220);
            ctx.strokeStyle = '#d1d5db';
            ctx.lineWidth = 2;
            ctx.stroke();
            
            // Signature
            ctx.textAlign = 'left';
            ctx.fillText('مدير المدرسة', 250, h - 200);
            ctx.beginPath();
            ctx.moveTo(200, h - 220);
            ctx.lineTo(500, h - 220);
            ctx.stroke();
            
            // Branding
            ctx.textAlign = 'center';
            ctx.font = 'bold 50px "Tajawal", sans-serif';
            ctx.fillStyle = colors.secondary;
            ctx.fillText('منصة نتيجتي - Ntegty.com', w/2, h - 120);
        },
        
        drawElegantCorner(ctx, x, y, size, color) {
            ctx.save();
            ctx.strokeStyle = color;
            ctx.lineWidth = 3;
            
            // Draw ornate corner pattern
            ctx.beginPath();
            if (x < 500 && y < 500) { // Top-left
                ctx.arc(x + size/2, y + size/2, size/2, Math.PI, Math.PI * 1.5);
            } else if (x > 500 && y < 500) { // Top-right
                ctx.arc(x - size/2, y + size/2, size/2, Math.PI * 1.5, Math.PI * 2);
            } else if (x > 500 && y > 500) { // Bottom-right
                ctx.arc(x - size/2, y - size/2, size/2, 0, Math.PI * 0.5);
            } else { // Bottom-left
                ctx.arc(x + size/2, y - size/2, size/2, Math.PI * 0.5, Math.PI);
            }
            ctx.stroke();
            
            ctx.restore();
        },
        
        drawElegantDivider(ctx, x, y, width, color) {
            ctx.strokeStyle = color;
            ctx.lineWidth = 3;
            
            // Left flourish
            ctx.beginPath();
            ctx.moveTo(x - width/2, y);
            ctx.quadraticCurveTo(x - width/2 + 80, y - 30, x - width/2 + 150, y);
            ctx.stroke();
            
            // Center line
            ctx.beginPath();
            ctx.moveTo(x - width/2 + 150, y);
            ctx.lineTo(x + width/2 - 150, y);
            ctx.stroke();
            
            // Right flourish
            ctx.beginPath();
            ctx.moveTo(x + width/2 - 150, y);
            ctx.quadraticCurveTo(x + width/2 - 80, y - 30, x + width/2, y);
            ctx.stroke();
            
            // Center diamond
            ctx.fillStyle = color;
            ctx.beginPath();
            ctx.moveTo(x, y - 15);
            ctx.lineTo(x + 15, y);
            ctx.lineTo(x, y + 15);
            ctx.lineTo(x - 15, y);
            ctx.fill();
        },
        
        downloadCertificate() {
            const link = document.createElement('a');
            const fileName = this.studentName ? 
                `شهادة_${this.studentName.replace(/\s+/g, '_')}.png` : 
                'شهادة_تقدير.png';
            link.download = fileName;
            link.href = this.canvas.toDataURL('image/png', 1.0);
            link.click();
        },
        
        shareOnSocial() {
            // Convert canvas to blob for sharing
            this.canvas.toBlob((blob) => {
                const file = new File([blob], 'certificate.png', { type: 'image/png' });
                
                if (navigator.share && navigator.canShare({ files: [file] })) {
                    navigator.share({
                        title: 'شهادة تقدير',
                        text: 'شاهد شهادة التقدير الخاصة بي!',
                        files: [file]
                    }).catch(err => console.log('Error sharing:', err));
                } else {
                    // Fallback: download the certificate
                    this.downloadCertificate();
                    alert('تم تحميل الشهادة! يمكنك الآن مشاركتها على وسائل التواصل الاجتماعي.');
                }
            }, 'image/png', 1.0);
        }
    }));
});
</script>

<style>
@keyframes bounce-slow {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
}
.animate-bounce-slow {
    animation: bounce-slow 3s ease-in-out infinite;
}
</style>
@endpush
@endsection
