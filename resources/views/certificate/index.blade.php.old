                                <option value="secondary">مثال: الصف الثاني الثانوي أو الثالث الثانوي</option>
                                <option value="primary">مثال: الصف السادس الابتدائي</option>
                            </select>
                        </div>

                        <!-- Achievement Details -->
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">
                                <span class="flex items-center gap-2">
                                    <span>🌟</span>
                                    <span>المجموع الكلي للطالب</span>
                                </span>
                            </label>
                            <input type="text" x-model="totalScore" @input="drawCertificate"
                                   class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-400 focus:border-blue-400 outline-none transition-all text-center font-bold text-lg" 
                                   placeholder="مثال: 140 أو 280 أو 99">
                        </div>

                        <!-- Max Score -->
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">
                                <span class="flex items-center gap-2">
                                    <span>📊</span>
                                    <span>المجموع الكلي من</span>
                                </span>
                            </label>
                            <input type="text" x-model="maxScore" @input="drawCertificate"
                                   class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-400 focus:border-blue-400 outline-none transition-all text-center font-bold text-lg" 
                                   placeholder="مثال: 140 أو 280 أو 99">
                        </div>

                        <!-- Gender Selection -->
