                <!-- Template Selection -->
                <div class="bg-white rounded-2xl shadow-xl p-5 md:p-6 border-2 border-purple-100">
                    <h3 class="text-lg md:text-xl font-black text-slate-800 mb-4 flex items-center gap-2 border-b-2 border-purple-100 pb-3">
                        <span class="text-2xl">🎨</span>
