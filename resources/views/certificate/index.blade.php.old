                                   placeholder="مثال: مدرسة النصر - القاهرة">
                        </div>

                        <!-- Grade Type -->
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">
                                <span class="flex items-center gap-2">
                                    <span>📚</span>
