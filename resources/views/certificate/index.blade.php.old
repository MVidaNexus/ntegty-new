                                <button @click="gender = 'male'; drawCertificate()" 
                                        class="flex-1 py-3 rounded-xl font-bold transition-all duration-300"
                                        :class="gender === 'male' ? 'bg-blue-500 text-white shadow-lg scale-105' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'">
                                    ذكر 👨
                                </button>
                                <button @click="gender = 'female'; drawCertificate()" 
                                        class="flex-1 py-3 rounded-xl font-bold transition-all duration-300"
