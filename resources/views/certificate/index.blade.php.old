@extends('layouts.layout')

@section('content')
<div class="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50/30 to-purple-50/30 py-8 md:py-12" x-data="certificateGenerator()">
    <!-- Header Section -->
    <div class="container mx-auto px-4 mb-8 md:mb-12">
        <div class="text-center max-w-4xl mx-auto">
            <div class="inline-block mb-6 animate-bounce-slow">
                <div class="flex items-center gap-3 bg-gradient-to-r from-blue-600 via-purple-600 to-pink-600 text-white px-6 md:px-8 py-4 rounded-full shadow-2xl">
                    <span class="text-3xl md:text-4xl">🏆</span>
                    <h1 class="text-xl md:text-3xl font-black">تصميم شهادة تقدير للمتفوقين في نتائج الامتحانات</h1>
                </div>
            </div>
            <p class="text-base md:text-lg text-gray-700 mb-4 font-semibold">اصنع شهادة نجاحك بنفسك وشارك فرحتك مع الجميع 🎉</p>
            <div class="flex flex-wrap items-center justify-center gap-4 md:gap-6 text-xs md:text-sm text-gray-600">
                <div class="flex items-center gap-2 bg-white px-4 py-2 rounded-full shadow-md">
                    <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
                    <span class="font-bold">مجاني 100%</span>
                </div>
                <div class="flex items-center gap-2 bg-white px-4 py-2 rounded-full shadow-md">
                    <svg class="w-5 h-5 text-blue-500" fill="currentColor" viewBox="0 0 20 20"><path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z"></path></svg>
                    <span class="font-bold">تصاميم احترافية</span>
                </div>
                <div class="flex items-center gap-2 bg-white px-4 py-2 rounded-full shadow-md">
                    <svg class="w-5 h-5 text-purple-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
                    <span class="font-bold">جودة عالية HD</span>
                </div>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-4">
        <div class="flex flex-col lg:flex-row gap-6 lg:gap-8 max-w-7xl mx-auto">
            <!-- Controls Sidebar -->
            <div class="w-full lg:w-2/5 xl:w-1/3 space-y-4 md:space-y-6">
                
                <!-- Student Information -->
                <div class="bg-white rounded-2xl shadow-xl p-5 md:p-6 border-2 border-blue-100">
                    <h3 class="text-lg md:text-xl font-black text-slate-800 mb-4 flex items-center gap-2 border-b-2 border-blue-100 pb-3">
                        <span class="text-2xl">📝</span>
                        <span>بيانات الشهادة</span>
                    </h3>
                    
                    <div class="space-y-4">
                        <!-- Name Input -->
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">
                                <span class="flex items-center gap-2">
                                    <span>👤</span>
                                    <span>ادخل اسم الطالب أو التلميذة</span>
