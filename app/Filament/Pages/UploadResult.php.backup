<?php

namespace App\Filament\Pages;

use App\Filament\Resources\UploadLogResource;
use App\Models\AcademicYear;
use App\Models\ExamType;
use App\Models\Governorate;
use App\Models\UploadLog;
use Filament\Forms\Components\FileUpload;
use Filament\Forms\Components\Section;
use Filament\Forms\Components\Select;
use Filament\Forms\Components\TextInput;
use Filament\Forms\Concerns\InteractsWithForms;
use Filament\Forms\Contracts\HasForms;
use Filament\Forms\Form;
use Filament\Notifications\Notification;
use Filament\Pages\Page;
use Illuminate\Support\Facades\Auth;

class UploadResult extends Page implements HasForms
{
    use InteractsWithForms;

    protected static ?string $navigationIcon = 'heroicon-o-arrow-up-tray';
    protected static ?string $navigationLabel = 'رفع ملف جديد';
    protected static ?string $title = 'رفع ملف نتائج جديد';
    protected static ?string $navigationGroup = 'النتائج';
    protected static ?int $navigationSort = 0;
    protected static string $view = 'filament.pages.upload-result';

    public ?array $data = [];

    public function mount(): void
    {
        $this->form->fill();
    }

    public function form(Form $form): Form
    {
        return $form
            ->schema([
                Section::make('بيانات الملف')
                    ->description('قم برفع ملف الإكسيل وتحديد البيانات الأساسية للدفعة.')
                    ->schema([
                        TextInput::make('batch_name')
                            ->label('اسم الدفعة / الملف')
                            ->placeholder('مثال: نتيجة القاهرة - اليوم الأول')
                            ->required()
                            ->maxLength(255)
                            ->columnSpanFull(),
                            
                        Select::make('academic_year_id')
                            ->label('السنة الدراسية')
                            ->options(AcademicYear::pluck('year', 'id'))
                            ->required(),

                        Select::make('country_id')
                            ->label('الدولة')
                            ->options(\App\Models\Country::pluck('name_ar', 'id'))
                            ->live()
                            ->afterStateUpdated(function (\Filament\Forms\Set $set) {
                                $set('exam_type_id', null);
                                $set('governorate_id', null);
                            })
                            ->required(),
                            
                        Select::make('exam_type_id')
                            ->label('نوع الامتحان')
                            ->options(fn (\Filament\Forms\Get $get) => \App\Models\ExamType::where('country_id', $get('country_id'))->pluck('name_ar', 'id'))
                            ->visible(fn (\Filament\Forms\Get $get) => $get('country_id'))
                            ->live()
                            ->required(),
                            
                        Select::make('system_type')
                            ->label('نظام الدراسة')
                            ->options([
                                'old' => 'نظام قديم',
                                'new' => 'نظام حديث',
                            ])
                            ->visible(function (\Filament\Forms\Get $get) {
                                $examTypeId = $get('exam_type_id');
                                if ($examTypeId) {
                                    $examType = ExamType::find($examTypeId);
                                    // Show only for Secondary Education (Egypt)
                                    if ($examType && str_contains($examType->code, 'secondary')) {
                                        return true;
                                    }
                                }
                                return false;
                            })
                            ->required(function (\Filament\Forms\Get $get) {
                                $examTypeId = $get('exam_type_id');
                                if ($examTypeId) {
                                    $examType = ExamType::find($examTypeId);
                                    if ($examType && str_contains($examType->code, 'secondary')) {
                                        return true;
                                    }
                                }
                                return false;
                            }),

                        Select::make('governorate_id')
                            ->label('المحافظة')
                            ->options(fn (\Filament\Forms\Get $get) => \App\Models\Governorate::where('country_id', $get('country_id'))->pluck('name_ar', 'id'))
                            ->searchable()
                            ->preload()
                            ->visible(function (\Filament\Forms\Get $get) {
                                if (!$get('country_id')) return false;
                                
                                $examTypeId = $get('exam_type_id');
                                if ($examTypeId) {
                                    $examType = ExamType::find($examTypeId);
                                    // Hide governorate for unified exams (Secondary, Diplomas)
                                    // Codes: eg_secondary, eg_diploma_...
                                    if ($examType && (str_contains($examType->code, 'secondary') || str_contains($examType->code, 'diploma'))) {
                                        return false;
                                    }
                                }
                                return true;
                            }),
                            
                        FileUpload::make('file_path')
                            ->label('ملف الإكسيل')
                            ->disk('local')
                            ->directory('results_uploads')
                            ->visibility('private')
                            ->acceptedFileTypes(['application/vnd.openxmlformats-officedocument.spreadsheetml.sheet', 'application/vnd.ms-excel', 'text/csv'])
                            ->required()
                            ->columnSpanFull()
                            ->helperText('يجب أن يحتوي الملف على صف رؤوس الأعمدة (Headers).'),
                    ])->columns(2),
            ])
            ->statePath('data');
    }

    public function create(): void
    {
        $data = $this->form->getState();

        // Extract headers immediately to avoid performance issues later
        $headers = [];
        try {
            if (isset($data['file_path'])) {
                $fullPath = \Illuminate\Support\Facades\Storage::disk('local')->path($data['file_path']);
                $service = new \App\Services\FileImportService();
                $headers = $service->getHeaders($fullPath);
            }
        } catch (\Exception $e) {
            // Log error but continue, we can try again in the resource
            \Illuminate\Support\Facades\Log::error('Failed to extract headers on upload: ' . $e->getMessage());
        }

        $uploadLog = UploadLog::create([
            'user_id' => Auth::id(),
            'batch_name' => $data['batch_name'],
            'academic_year_id' => $data['academic_year_id'],
            'exam_type_id' => $data['exam_type_id'],
            'system_type' => $data['system_type'] ?? null,
            'governorate_id' => $data['governorate_id'] ?? null,
            'file_path' => $data['file_path'],
            'filename' => basename($data['file_path']),
            'file_type' => pathinfo($data['file_path'], PATHINFO_EXTENSION),
            'status' => 'pending',
            'records_count' => 0,
            'mapping_data' => ['_headers' => $headers], // Cache headers
        ]);

        Notification::make()
            ->title('تم رفع الملف بنجاح')
            ->body('يرجى الآن تعيين الأعمدة واعتماد الملف.')
            ->success()
            ->send();

        // Redirect to the Edit page of the Resource to do the mapping
        $this->redirect(UploadLogResource::getUrl('edit', ['record' => $uploadLog]));
    }
}
